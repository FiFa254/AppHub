<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- DB แยกสำหรับ test — ถูกลบและสร้างใหม่จาก setup.sql ทุกครั้งที่รัน -->
    <add name="AppHubDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=AppHubDB_Test;Integrated Security=True"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
</configuration>
