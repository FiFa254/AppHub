<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!--
      แก้ให้ตรงกับ environment:
        LocalDB    : Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=AppHubDB;Integrated Security=True
        SQLExpress : Data Source=.\SQLEXPRESS;Initial Catalog=AppHubDB;Integrated Security=True
    -->
    <add name="AppHubDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=AppHubDB;Integrated Security=True"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
</configuration>
